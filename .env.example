# Copy to ".env" to override defaults. Every value is optional:
# "docker compose up -d" works without a .env file.

# Public address of the shop (used in e-mail links and the Google OAuth redirect).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Sign the session cookies. Change it for any shared deployment.
JWT_SECRET=change-me-to-a-long-random-string

# The single administrator account created on first start.
ADMIN_EMAIL=admin@techhaven.local
ADMIN_PASSWORD=Admin@123

# E-mail. Without these lines every e-mail is delivered to the built-in Mailpit
# inbox at http://localhost:8025. To send real mail through Gmail, uncomment and
# fill in (use an App Password: Google Account > Security > App passwords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=TechHaven <your.address@gmail.com>

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID,
# type "Web application", authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: lets Google Gemini write the AI shopping assistant's replies.
# Without a key the assistant still answers with rule-based replies.
# Free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Number of replicas behind the load balancer.
API_REPLICAS=3
REALTIME_REPLICAS=2
